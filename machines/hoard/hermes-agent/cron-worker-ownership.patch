+def adopt_fire_claim(job_id: str, *, expected_owner: str, execution_id: str) -> Optional[dict]:
+    """Bind this fire's stable fencing token to its adopted execution."""
+    def apply(jobs, _i, job):
+        claim = job.get("fire_claim")
+        if not isinstance(claim, dict) or claim.get("by") != expected_owner:
+            return None
+        claim = dict(claim, at=_hermes_now().isoformat(),
+                     job_id=job_id, execution_id=execution_id)
+        job["fire_claim"] = claim
+        save_jobs(jobs)
+        return dict(claim)
+
+    return _under_fire_fence(job_id, lambda: _with_job(job_id, apply, None))
+
