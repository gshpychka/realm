@@ -0,0 +1,151 @@
+"""Authorized continuation of interactive work interrupted by an orderly gateway stop."""
+from copy import deepcopy
+from contextvars import ContextVar
+
+from gateway.restart_loop_guard import DEFAULT_MAX_RESTARTS
+
+REQUEST_PREFIX = 'restart-continue:'
+# Process-local flag on the captured result: this settlement committed its continuation.
+CONTINUED = 'restart_continuation_queued'
+executing_continuation = ContextVar('executing_restart_continuation', default=False)
+CONTINUE_TEXT = (
+    '[Hermes restart continuation] The gateway restarted while your previous turn in this conversation was '
+    'still running. Finish that latest unfinished task from the saved conversation and tool results; the '
+    'user does not need to resend it. Do not repeat actions whose results are already recorded, and do not '
+    'run any restart, shutdown or deploy command again. If a tool outcome is missing or uncertain, check the '
+    'current state before retrying it. This message grants no approval and answers no question: anything '
+    'that needs approval or clarification still needs it from the user. If the task is already complete, '
+    'say so briefly instead of redoing it.')
+# Consecutive continuations of one task (the restart-loop breaker's own bound).
+_MAX_CHAIN = DEFAULT_MAX_RESTARTS
+_LOCAL_SURFACES = frozenset({'cli', 'tui', 'desktop'})  # created_source of cli / tui / gui sessions
+_NATIVE_PLATFORMS = frozenset({'telegram'})
+_LOCAL_FIELDS = frozenset({'text', 'attachments_v1', 'surface_v1', 'display_v1', 'cli_turn_v1',
+                           'local_operator_v1', 'finite', 'unattended'})
+# A transcript ended by these was replaced; a shutdown/close stamp is reopened by the next claim.
+_RESET_REASONS = frozenset({'session_reset', 'auto_reset', 'compression_exhausted_reset',
+                            'superseded_by_repair', 'adopted_by_profile'})
+_DROPPED_EVENT_FIELDS = ('reply_to_message_id', 'reply_to_text', 'reply_to_author_id', 'reply_to_author_name',
+                         'reply_to_is_own_message', 'edit_revision', 'media_types', 'media_text_inlined', 'metadata')
+
+
+def enabled(db) -> bool:
+    """``agent.restart_continue`` of the profile that owns ``db`` (its home holds the store)."""
+    from pathlib import Path
+    from gateway.run import _load_gateway_config
+    try:
+        agent = _load_gateway_config(Path(db.db_path).resolve().parent / 'config.yaml').get('agent')
+    except Exception:
+        return False
+    return isinstance(agent, dict) and agent.get('restart_continue') is True
+
+
+def is_continuation(row) -> bool:
+    """The admission carries the restart-continuation identity and exact input."""
+    return (isinstance(row, dict) and str(row.get('request_id', '')).startswith(REQUEST_PREFIX)
+            and (row.get('payload') or {}).get('text') == CONTINUE_TEXT)
+
+
+def cancel_superseded(conn, *, epoch, row):
+    """Cancel a queued continuation superseded by a later input, inside the claim transaction."""
+    from hermes_state_runtime import _admission, _row, cancel_session_input_on
+    if row is None:
+        return
+    current = _row(_admission(conn, row['admission_id']))
+    if current['status'] != 'queued' or not is_continuation(current):
+        return
+    if conn.execute('SELECT 1 FROM session_admissions WHERE target_session_id=? AND seq>? LIMIT 1',
+                    (current['target_session_id'], current['seq'])).fetchone() is not None:
+        cancel_session_input_on(conn, epoch=epoch, admission_id=current['admission_id'])
+
+
+def _payload(row, created_source):
+    """The continuation input for an attended telegram / cli / tui / gui turn, else None."""
+    from gateway.session_unattended_unknown import is_unattended
+    payload = row['payload']
+    if (is_unattended(row) or str(row['request_id']).startswith('hosted:')
+            or payload.get('finite') or payload.get('unattended')):
+        return None
+    native = payload.get('native_text_v1')
+    if native is not None:
+        if (set(payload) != {'text', 'native_text_v1'} or 'automation' in native or 'webhook_delivery' in native
+                or (native.get('source') or {}).get('platform') not in _NATIVE_PLATFORMS
+                or not str(row['principal_id']).startswith('messaging:')):
+            return None
+        # Same route, sender, provenance and bot; none of the original message's content or media.
+        envelope = {key: deepcopy(value) for key, value in native.items()
+                    if key not in ('media', 'message_type', 'ingress_sha256')}
+        event = envelope['event']
+        for key in _DROPPED_EVENT_FIELDS:
+            event.pop(key, None)
+        event['message_id'] = event['platform_update_id'] = None
+        return {'text': CONTINUE_TEXT, 'native_text_v1': envelope}
+    local_operator = created_source == 'telegram' and payload.get('local_operator_v1')
+    if ((created_source not in _LOCAL_SURFACES and not local_operator)
+            or 'text' not in payload or not set(payload) <= _LOCAL_FIELDS):
+        return None
+    continued = {'text': CONTINUE_TEXT, 'display_v1': {'kind': 'hidden'}}
+    surface = {key: value for key, value in (payload.get('surface_v1') or {}).items()
+               if key in ('surface', 'voice_turn')}
+    cli = {key: value for key, value in (payload.get('cli_turn_v1') or {}).items()
+           if key in ('turn_author', 'model_override', 'clarify_batch')}
+    if surface:
+        continued['surface_v1'] = surface
+    if cli:
+        continued['cli_turn_v1'] = cli
+    if 'local_operator_v1' in payload:
+        continued['local_operator_v1'] = dict(payload['local_operator_v1'])
+    return continued
+
+
+def _depth(conn, row):
+    """How many continuations precede ``row`` in its task's chain."""
+    from hermes_state_runtime import RuntimeStoreError, _admission
+    depth, request_id = 0, str(row['request_id'])
+    while request_id.startswith(REQUEST_PREFIX) and depth < _MAX_CHAIN:
+        depth += 1
+        try:
+            request_id = str(dict(_admission(conn, request_id[len(REQUEST_PREFIX):])).get('request_id') or '')
+        except RuntimeStoreError:
+            break
+    return depth
+
+
+def queue_continuation(conn, *, epoch, row):
+    """Inside the interrupted claim's settlement write: admit its continuation, or None.
+
+    ``row`` is the claimed admission (``claim_session_input``). Nothing is admitted when any later
+    input exists on the FIFO (queued, steered, redirected or settled), an execution is unknown, the
+    transcript was reset or archived, the chain reached its bound, or the turn is not an
+    attended native interactive one. A refusal never fails the settlement it rides."""
+    from hermes_state_local_lineage import local_physical_target
+    from hermes_state_runtime import RuntimeStoreError, _canonical_chain, _session, admit_session_input_on
+    from hermes_state_runtime_workers import worker_states
+    target = row['target_session_id']
+    try:
+        session = _session(conn, target)
+        payload = _payload(row, session['created_source'] or session['source'])
+        if payload is None or _depth(conn, row) >= _MAX_CHAIN:
+            return None
+        if conn.execute("SELECT 1 FROM session_admissions WHERE target_session_id=? AND admission_id!=? "
+                        "AND (seq>? OR status IN ('queued','started','unknown')) LIMIT 1",
+                        (target, row['admission_id'], row['seq'])).fetchone() is not None:
+            return None
+        if 'unknown' in worker_states(conn, target):
+            return None
+        tip = conn.execute('SELECT end_reason, archived FROM sessions WHERE id=?',
+                           (_canonical_chain(conn, local_physical_target(conn, target))[-1],)).fetchone()
+        if tip is None or tip['end_reason'] in _RESET_REASONS or tip['archived']:
+            return None
+        return admit_session_input_on(conn, epoch=epoch, principal_id=row['principal_id'], session_id=target,
+                                      request_id=REQUEST_PREFIX + row['admission_id'], payload=payload)
+    # Storage errors propagate (the settlement retries whole); any refusal or malformed row only skips.
+    except (RuntimeStoreError, KeyError, TypeError, ValueError):
+        return None
+
+
+def continuation_queued(conn, row) -> bool:
+    """``row``'s continuation is committed."""
+    return conn.execute('SELECT 1 FROM session_admissions WHERE principal_id=? AND target_session_id=? '
+                        'AND request_id=?', (row['principal_id'], row['target_session_id'],
+                                             REQUEST_PREFIX + row['admission_id'])).fetchone() is not None
