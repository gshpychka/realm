@@ -106,2 +107,19 @@
     # Close the WebDriver instance
     driver.quit()
+
+
+def wait_for_http(process, url, method="GET", **kwargs):
+    """Wait for an HTTP response instead of assuming a fixed startup duration."""
+    deadline = time.monotonic() + 60
+    last_error = None
+    while time.monotonic() < deadline:
+        assert process.poll() is None, f"Server exited with {process.returncode}"
+        try:
+            response = requests.request(method, url, timeout=1, **kwargs)
+            if response.status_code == 200:
+                return
+            last_error = f"HTTP {response.status_code}"
+        except requests.RequestException as error:
+            last_error = error
+        time.sleep(0.1)
+    raise AssertionError(f"Server did not become ready at {url}: {last_error}")
