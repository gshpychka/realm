         # Use the provided API instance
         self.api = api
 
+        # Entities derive their values from the cached schedule and the current
+        # time, but are only written when listeners are updated. Polling alone
+        # leaves them stale for up to one scan interval after a slot boundary.
+        self._unsub_schedule_boundary: CALLBACK_TYPE | None = None
+        self._schedule_boundaries_stopped = False
+
+    def next_schedule_boundary(self, now: datetime.datetime) -> datetime.datetime:
+        """
+        Return the next time after `now` at which entity values can change.
+
+        Uses only the cached planned and probable schedules. The next local
+        midnight is always a candidate, so a missing or malformed schedule
+        still re-evaluates once a day instead of never (or in a tight loop).
+        """
+        boundaries = [
+            dt_utils.start_of_local_day(now.date() + datetime.timedelta(days=1))
+        ]
+        horizon = now + SCHEDULE_BOUNDARY_LOOKAHEAD
+        for api in (self.api.planned, self.api.probable):
+            try:
+                boundaries.extend(
+                    point
+                    for event in api.get_events_between(now, horizon)
+                    for point in (event.start, event.end)
+                    if point > now
+                )
+            except Exception:  # noqa: BLE001
+                LOGGER.warning("Failed to get schedule boundaries", exc_info=True)
+        return min(boundaries)
+
+    @callback
+    def _async_cancel_schedule_boundary(self) -> None:
+        """Cancel the pending boundary timer, if any."""
+        if self._unsub_schedule_boundary:
+            self._unsub_schedule_boundary()
+            self._unsub_schedule_boundary = None
+
+    @callback
+    def _async_schedule_boundary_refresh(self) -> None:
+        """Arm a single timer for the next schedule boundary."""
+        self._async_cancel_schedule_boundary()
+        if self._schedule_boundaries_stopped:
+            return
+        boundary = self.next_schedule_boundary(dt_utils.now())
+        LOGGER.debug("Next schedule boundary: %s", boundary)
+        self._unsub_schedule_boundary = async_track_point_in_time(
+            self.hass, self._async_handle_schedule_boundary, boundary
+        )
+
+    @callback
+    def _async_handle_schedule_boundary(self, _scheduled: datetime.datetime) -> None:
+        """Republish entities from the cached schedule without fetching."""
+        self._unsub_schedule_boundary = None
+        # Unlike async_set_updated_data, this leaves the poll timer untouched.
+        self.async_update_listeners()
+        # Re-arm from the real current time: a late timer skips passed points.
+        self._async_schedule_boundary_refresh()
+
+    @callback
+    def _async_refresh_finished(self) -> None:
+        """Re-arm boundaries after every poll, including failed polls on cache."""
+        super()._async_refresh_finished()
+        self._async_schedule_boundary_refresh()
+
+    async def async_shutdown(self) -> None:
+        """Cancel the boundary timer with the poll timer on entry unload."""
+        self._schedule_boundaries_stopped = True
+        self._async_cancel_schedule_boundary()
+        await super().async_shutdown()
