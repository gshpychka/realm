  "weather_source": "{% set ns = namespace(t='') %} {# current #} {% if is_number(state_attr((\"\\\"weather.openweathermap\\\"\" | from_json), 'temperature')) %}{% set ns.t = ns.t ~ \"It's \" ~ (now_temp | round(0)) ~ \" degrees and \" ~ now_cond ~ \". \" %}{% else %}{% set ns.t = 'Current weather information is unavailable. ' %}{% endif %} {% if diff > 2 %}\n  {% set ns.t = ns.t ~ \"Feels like \" ~ (now_feels | round(0)) ~ \" degrees. \" %}\n{% endif %} {% if now_precip > 0 %}\n  {% set ns.t = ns.t ~ \"There's precipitation right now. \" %}\n{% endif %} {# next 6 h #} {% if will_rain %}\n  {% set ns.t = ns.t ~ \"Rain is likely within the next few hours. \" %}\n{% endif %} {% if (max_t - now_temp) > 3 %}\n  {% set ns.t = ns.t ~ \"It will warm up to about \" ~ (max_t | round(0)) ~ \" degrees in the next six hours. \" %}\n{% elif (now_temp - min_t) > 3 %}\n  {% set ns.t = ns.t ~ \"Expect it to cool down to around \" ~ (min_t | round(0)) ~ \" degrees in the next six hours. \" %}\n{% endif %} {{ ns.t | trim }}",
  "media_actions": [
    {
      "variables": {
        "slots": {
          "template": "slots"
        }
      }
    },
    {
      "variables": {
        "raw_title": {
          "template": "raw_title"
        }
      }
    },
    {
      "variables": {
        "raw_type": {
          "template": "raw_type"
        }
      }
    },
    {
      "variables": {
        "media_kind": {
          "template": "media_kind"
        }
      }
    },
    {
      "variables": {
        "clean_title": {
          "template": "clean_title"
        }
      }
    },
    {
      "alias": "Stop if this is not a movie or show",
      "if": [
        {
          "alias": "The title is a list or calendar entry",
          "condition": "template",
          "value_template": {
            "template": "reject_media"
          }
        }
      ],
      "then": [
        {
          "alias": "Say nothing was added",
          "set_conversation_response": "That sounds like a list or calendar item, not a movie or show, so I didn't add anything."
        },
        {
          "stop": "Not a media request"
        }
      ]
    },
    {
      "alias": "Classify media kind via LLM if necessary",
      "choose": [
        {
          "alias": "Necessary",
          "conditions": [
            {
              "alias": "media_kind is unknown",
              "condition": "template",
              "value_template": {
                "template": "unknown_media"
              }
            }
          ],
          "sequence": [
            {
              "action": "conversation.process",
              "alias": "Ask LLM to classify media",
              "data": {
                "agent_id": "conversation.chatgpt_2",
                "text": {
                  "template": "classifier_prompt"
                }
              },
              "response_variable": "llm_kind"
            },
            {
              "alias": "set classified media_kind variable",
              "variables": {
                "media_kind": {
                  "template": "classified_media"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "choose": [
        {
          "alias": "media_kind is STILL unknown",
          "conditions": [
            {
              "alias": "media_kind is unknown",
              "condition": "template",
              "value_template": {
                "template": "unknown_media"
              }
            }
          ],
          "sequence": [
            {
              "alias": "Set response with error message",
              "set_conversation_response": {
                "template": "unsure_media"
              }
            }
          ]
        }
      ],
      "default": [
        {
          "alias": "Choose between movie or show",
          "choose": [
            {
              "alias": "Movie",
              "conditions": [
                {
                  "alias": "media_kind is movie",
                  "condition": "template",
                  "value_template": {
                    "template": "movie_media"
                  }
                }
              ],
              "sequence": [
                {
                  "action": "hassarr.add_overseerr_movie",
                  "data": {
                    "title": {
                      "template": "title_case"
                    }
                  }
                }
              ]
            },
            {
              "alias": "Show",
              "conditions": [
                {
                  "alias": "media_kind is show",
                  "condition": "template",
                  "value_template": {
                    "template": "show_media"
                  }
                }
              ],
              "sequence": [
                {
                  "action": "hassarr.add_overseerr_tv_show",
                  "data": {
                    "title": {
                      "template": "title_case"
                    }
                  }
                }
              ]
            }
          ]
        },
        {
          "action": "ai_task.generate_data",
          "alias": "Ask for a joke",
          "data": {
            "entity_id": "ai_task.openai_ai_task",
            "instructions": {
              "template": "confirmation_prompt"
            },
            "task_name": "Media added confirmation"
          },
          "response_variable": "witty_remark"
        },
        {
          "alias": "Set success response",
          "set_conversation_response": {
            "template": "media_confirmation"
          }
        }
      ]
    }
  ],
