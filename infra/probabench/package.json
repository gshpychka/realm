{
  "name": "probabench",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "bun2nix -o bun.nix",
    "typecheck": "tsc -b && bun run --cwd infra typecheck",
    "lint": "cd ../.. && biome check --config-path biome.json infra/probabench",
    "format": "cd ../.. && biome format --config-path biome.json --write infra/probabench",
    "test": "vitest run",
    "check": "bun run typecheck && bun run test && bun run build",
    "bench": "bun packages/runner/src/index.ts",
    "dev": "bun run --cwd packages/web dev",
    "build": "bun run --cwd packages/web build",
    "plan": "bun run --cwd infra plan",
    "deploy": "bun run --cwd infra deploy",
    "destroy": "bun run --cwd infra destroy",
    "dev:infra": "bun run --cwd infra dev"
  },
  "devDependencies": {
    "@effect/vitest": "^0.29.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.9.3",
    "vitest": "^3.0.5"
  },
  "workspaces": [
    "packages/*",
    "infra"
  ],
  "dependencies": {
    "effect": "3.21.4"
  },
  "trustedDependencies": [],
  "patchedDependencies": {
    "@distilled.cloud/aws@1.0.0-rc.15": "infra/patches/@distilled.cloud%2Faws@1.0.0-rc.15.patch"
  }
}
