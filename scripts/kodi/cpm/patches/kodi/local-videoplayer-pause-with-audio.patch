+double CVideoPlayerAudio::SetOutputSpeed(int speed)
+{
+  if (!m_messageQueue.IsInited())
+  {
+    m_speed = speed;
+    return DVD_NOPTS_VALUE;
+  }
+
+  auto msg = std::make_shared<CDVDMsgAudioOutputSpeed>(speed);
+  m_messageQueue.Put(msg, 1);
+  // the audio thread takes messages between packets
+  if (!msg->m_applied.Wait(200ms))
+    return DVD_NOPTS_VALUE;
+
+  return msg->m_outputDelay;
+}
