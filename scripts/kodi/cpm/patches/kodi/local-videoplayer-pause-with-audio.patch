+// A stream paused in sync resumes in sync: the sink streams on while the stream
+// is paused, so the stream's next sample plays right after the filler the sink
+// holds.
+void CActiveAE::ResumeStream(CActiveAEStream* stream)
+{
+  if (stream->m_paused)
+  {
+    if (stream->m_syncState == CAESyncInfo::AESyncState::SYNC_INSYNC)
+      stream->m_syncError.Flush(stream->GetErrorInterval());
+    else
+      stream->m_syncState = CAESyncInfo::AESyncState::SYNC_START;
+  }
+  stream->m_paused = false;
+}
