+void CDVDClock::StopAt(double clock)
+{
+  std::unique_lock lock(m_critSection);
+
+  const double current = GetClock();
+  m_startAt = 0;
+  if (m_pauseClock)
+    return;
+
+  m_stopAt = std::max(clock, current);
+}
+
+double CDVDClock::GetStop()
+{
+  std::unique_lock lock(m_critSection);
+
+  const double clock = GetClock();
+  if (m_pauseClock)
+    return clock;
+
+  return m_stopAt;
+}
+
+bool CDVDClock::IsStopped()
+{
+  std::unique_lock lock(m_critSection);
+
+  GetClock();
+  return m_pauseClock != 0;
+}
