+void CDataCacheCore::SetVideoHdr10PlusFrameMetadata(HDR10PlusFrameMetadata value)
+{
+  std::lock_guard lock(m_videoPlayerSection);
+
+  uint64_t pts = value.pts;
+  m_playerVideoInfo.hdr10PlusFrameMetadataMap.insert(pts, std::move(value));
+}
+
+// The metadata of the frame on screen, or of the frame decoded nearest to it.
+HDR10PlusFrameMetadata CDataCacheCore::GetVideoHdr10PlusFrameMetadata()
+{
+  std::lock_guard lock(m_videoPlayerSection);
+
+  uint64_t pts = GetRenderPts();
+  auto frameMetadata = m_playerVideoInfo.hdr10PlusFrameMetadataMap.findOrLatest(pts);
+  if (frameMetadata != m_playerVideoInfo.hdr10PlusFrameMetadataMap.end())
+    return frameMetadata->second;
+  return {};
+}
