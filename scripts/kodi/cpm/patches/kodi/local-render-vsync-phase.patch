+bool aml_get_vsync_timing_us(int& timeToNextVsyncUs, int& vsyncPeriodUs)
+{
+  timeToNextVsyncUs = 0;
+  vsyncPeriodUs = 0;
+
+  int fbFd{-1};
+  std::string fbPath;
+  if (!GetFramebufferDevice(fbFd, fbPath))
+    return false;
+
+  fb_vsync_timing_request req{};
+  if (ioctl(fbFd, FBIO_GET_VSYNC_TIMING_64, &req) < 0)
+  {
+    logM(LOGERROR, "ioctl failed on {}: {}", fbPath, strerror(errno));
+    return false;
+  }
+
+  if (req.now_ts <= 0 || req.next_vsync_ts < req.now_ts)
+    return false;
+
+  int64_t periodNs = req.period_ns;
+  if (periodNs <= 0 && req.last_vsync_ts > 0)
+    periodNs = req.next_vsync_ts - req.last_vsync_ts;
+  if (periodNs <= 0)
+    return false;
+
+  timeToNextVsyncUs = static_cast<int>(std::min<int64_t>((req.next_vsync_ts - req.now_ts) / 1000,
+                                                         std::numeric_limits<int>::max()));
+  vsyncPeriodUs = static_cast<int>(periodNs / 1000);
+
+  return true;
+}
