+// Consecutive paced frames whose targets come within a quarter vsync period of
+// a vsync before the release target moves half a period; it outlasts the clock
+// corrections that follow a start or a seek.
+constexpr int VSYNC_NEAR_FRAMES = 8;
+
+// Time by which a frame's release target precedes its presentation time: half
+// a vsync period or none, switched once VSYNC_NEAR_FRAMES consecutive paced
+// frames have targets near a vsync. Kodi's clock jitters against the display,
+// so a target that close falls on alternating sides of the vsync, and the
+// display shows two frames at one vsync and none at the next.
+double VsyncPhaseOffset(double presentPts,
+                        double presentFrameTime,
+                        double clockPts,
+                        std::atomic<bool>& halfPeriodEarly,
+                        std::atomic<int>& framesNearVsync)
+{
+  int nextVsyncUs{0};
+  int periodUs{0};
+  if (!aml_get_vsync_timing_us(nextVsyncUs, periodUs))
+    return 0.0;
+
+  // A frame lasting whole vsync periods keeps its phase from frame to frame.
+  const double vsyncsPerFrame = std::round(presentFrameTime / periodUs);
+  if (vsyncsPerFrame < 1.0 ||
+      std::abs(presentFrameTime - vsyncsPerFrame * periodUs) > periodUs / 100.0)
+    return 0.0;
+
+  bool early = halfPeriodEarly.load();
+  const double offsetUs = early ? periodUs / 2.0 : 0.0;
+  const double waitUs = presentPts - offsetUs - clockPts;
+
+  // Only a frame paced to vsync, due within the window ClockAlignImpl paces, shows the phase.
+  if (waitUs <= 0.0 || waitUs > presentFrameTime * 3.0)
+    return offsetUs;
+
+  double targetAfterVsyncUs = std::fmod(waitUs - nextVsyncUs, periodUs);
+  if (targetAfterVsyncUs < 0.0)
+    targetAfterVsyncUs += periodUs;
+
+  if (std::min(targetAfterVsyncUs, periodUs - targetAfterVsyncUs) >= periodUs / 4.0)
+  {
+    framesNearVsync = 0;
+    return offsetUs;
+  }
+
+  if (++framesNearVsync < VSYNC_NEAR_FRAMES)
+    return offsetUs;
+
+  framesNearVsync = 0;
+  early = !early;
+  halfPeriodEarly = early;
+  logM(LOGDEBUG, "half period early:[{}] target after vsync:[{:.0f}] period:[{}]",
+                 early, targetAfterVsyncUs, periodUs);
+
+  return early ? periodUs / 2.0 : 0.0;
+}
