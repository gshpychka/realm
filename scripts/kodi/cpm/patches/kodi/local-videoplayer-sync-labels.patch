+void CVideoPlayer::UpdateAVSyncError()
+{
+  if (!m_avSyncTimer.IsTimePast())
+    return;
+  m_avSyncTimer.Set(100ms);
+
+  if (m_playSpeed != DVD_PLAYSPEED_NORMAL || !m_VideoPlayerAudio->IsInited())
+  {
+    m_avSyncSamples.clear();
+    CServiceBroker::GetDataCacheCore().SetAVSyncError({});
+    return;
+  }
+
+  // The picture shows each frame when the clock reaches it, so the audio's
+  // distance from the clock is the A/V error. ActiveAE's measure counts the
+  // output's real delay; with passthrough the audio player's own position
+  // estimate lags it.
+  m_avSyncSamples.push_back(m_VideoPlayerAudio->GetSyncError());
+  if (m_avSyncSamples.size() > AV_SYNC_SAMPLES)
+    m_avSyncSamples.pop_front();
+  const double sum = std::accumulate(m_avSyncSamples.begin(), m_avSyncSamples.end(), 0.0);
+  CServiceBroker::GetDataCacheCore().SetAVSyncError(sum / m_avSyncSamples.size() /
+                                                     DVD_TIME_BASE);
+}
