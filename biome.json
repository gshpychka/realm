{
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "package.json",
      "tsconfig.base.json",
      "packages/dura/**/*.ts",
      "packages/dura/**/*.json",
      "modules/**/*.ts",
      "modules/**/*.js",
      "infra/**/*.ts",
      "infra/**/*.tsx",
      "infra/**/*.css",
      "!**/node_modules"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "rules": {
      "preset": "recommended"
    }
  },
  "overrides": [
    {
      "includes": ["packages/dura/**"],
      "formatter": { "lineWidth": 110 },
      "linter": { "rules": { "suspicious": { "noConsole": "off" }, "style": { "useImportType": "error" }, "performance": { "noReExportAll": "error" } } }
    },
    {
      "includes": ["infra/probabench/**/*.css"],
      "linter": {
        "rules": {
          "style": {
            "noDescendingSpecificity": "off"
          }
        }
      }
    }
  ]
}
