+/*
+ * Handle a mode report (DECRPM) for a mode queried to detect a feature.
+ * Returns 0 for success, -1 for failure, 1 for partial.
+ */
+static int
+tty_keys_mode_report(struct tty *tty, const char *buf, size_t len,
+    size_t *size)
+{
+	static const struct {
+		const char	*prefix;
+		const char	*feature;
+		int		 flag;
+	} modes[] = {
+		{ "\033[?2026;", "sync", TTY_HAVESYNC },
+		{ "\033[?5522;", "osc5522", TTY_HAVEPASTEEVENTS }
+	};
+	struct client	*c = tty->client;
+	const char	*prefix;
+	size_t		 i;
+	u_int		 j;
+	int		 status, partial = 0;
+
+	*size = 0;
+	for (j = 0; j < nitems(modes); j++) {
+		if (tty->flags & modes[j].flag)
+			continue;
+		prefix = modes[j].prefix;
+
+		/* The response is always the prefix then Ps$y. */
+		for (i = 0; prefix[i] != '\0'; i++) {
+			if (i == len || buf[i] != prefix[i])
+				break;
+		}
+		if (prefix[i] != '\0') {
+			if (i == len)
+				partial = 1;
+			continue;
+		}
+		if (i == len)
+			return (1);
+		if (buf[i] < '0' || buf[i] > '4')
+			return (-1);
+		status = buf[i++] - '0';
+		if (i == len)
+			return (1);
+		if (buf[i++] != '$')
+			return (-1);
+		if (i == len)
+			return (1);
+		if (buf[i++] != 'y')
+			return (-1);
+		*size = i;
+
+		if (status == 1 || status == 2 || status == 3) {
+			tty_parse_client_features(c, modes[j].feature, ",");
+			tty_update_features(tty);
+		}
+		log_debug("%s: received DECRPM %.*s", c->name, (int)*size, buf);
+		tty->flags |= modes[j].flag;
+
+		return (0);
+	}
+	return (partial ? 1 : -1);
+}
