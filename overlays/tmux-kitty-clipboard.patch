+/*
+ * The kitty clipboard protocol (OSC 5522) request in flight. The clipboard is
+ * a single resource, so one pane at a time may have a request with a client
+ * terminal. The request carries tmux's own id, which the terminal echoes, so
+ * replies are told apart from paste events and routed back to the pane.
+ */
+static struct {
+	struct client		*c;
+	u_int			 pane;
+	enum input_end_type	 end;
+	char			*id;	/* the pane's own id, if any */
+	int			 write;
+	u_int			 seq;
+	struct event		 timer;
+} input_osc5522_request;
+
+/* Seconds without a packet before a request stops holding the clipboard. */
+#define INPUT_OSC5522_TIMEOUT 30
+
+/* Find a metadata value in an OSC 5522 packet body. */
+static const char *
+input_osc5522_get(const char *body, size_t len, const char *key, size_t *vlen)
+{
+	const char	*meta_end, *entry, *next;
+	size_t		 keylen = strlen(key);
+
+	if ((meta_end = memchr(body, ';', len)) == NULL)
+		meta_end = body + len;
+	for (entry = body; entry < meta_end; entry = next + 1) {
+		if ((next = memchr(entry, ':', meta_end - entry)) == NULL)
+			next = meta_end;
+		if ((size_t)(next - entry) > keylen &&
+		    strncmp(entry, key, keylen) == 0 &&
+		    entry[keylen] == '=') {
+			*vlen = next - entry - keylen - 1;
+			return (entry + keylen + 1);
+		}
+	}
+	return (NULL);
+}
+
+/* Whether a metadata value is the given string. */
+static int
+input_osc5522_is(const char *value, size_t vlen, const char *s)
+{
+	return (value != NULL && vlen == strlen(s) &&
+	    strncmp(value, s, vlen) == 0);
+}
+
+/* Build an OSC 5522 packet from a body with its id replaced. */
+static char *
+input_osc5522_packet(const char *body, size_t len, const char *id,
+    enum input_end_type end)
+{
+	const char	*meta_end, *entry, *next;
+	char		*meta, *tmp, *packet;
+
+	if ((meta_end = memchr(body, ';', len)) == NULL)
+		meta_end = body + len;
+	meta = xstrdup("");
+	for (entry = body; entry < meta_end; entry = next + 1) {
+		if ((next = memchr(entry, ':', meta_end - entry)) == NULL)
+			next = meta_end;
+		if (next - entry >= 3 && strncmp(entry, "id=", 3) == 0)
+			continue;
+		xasprintf(&tmp, "%s%s%.*s", meta, *meta == '\0' ? "" : ":",
+		    (int)(next - entry), entry);
+		free(meta);
+		meta = tmp;
+	}
+	if (id != NULL) {
+		xasprintf(&tmp, "%s%sid=%s", meta, *meta == '\0' ? "" : ":",
+		    id);
+		free(meta);
+		meta = tmp;
+	}
+	xasprintf(&packet, "\033]5522;%s%.*s%s", meta,
+	    (int)(body + len - meta_end), meta_end,
+	    end == INPUT_END_BEL ? "\007" : "\033\\");
+	free(meta);
+	return (packet);
+}
+
+/* Release the clipboard from the request in flight. */
+static void
+input_osc5522_clear(void)
+{
+	if (evtimer_initialized(&input_osc5522_request.timer))
+		evtimer_del(&input_osc5522_request.timer);
+	free(input_osc5522_request.id);
+	input_osc5522_request.id = NULL;
+	input_osc5522_request.c = NULL;
+}
+
+/* Request timer. The terminal stopped answering. */
+static void
+input_osc5522_timer_callback(__unused int fd, __unused short events,
+    __unused void *arg)
+{
+	log_debug("%s: request %u timed out", __func__,
+	    input_osc5522_request.seq);
+	input_osc5522_clear();
+}
+
+/* Restart the request timer. */
+static void
+input_osc5522_start_timer(void)
+{
+	struct timeval	tv = { .tv_sec = INPUT_OSC5522_TIMEOUT };
+
+	if (!evtimer_initialized(&input_osc5522_request.timer)) {
+		evtimer_set(&input_osc5522_request.timer,
+		    input_osc5522_timer_callback, NULL);
+	}
+	evtimer_add(&input_osc5522_request.timer, &tv);
+}
+
+/* Answer a pane's OSC 5522 request with an error status. */
+static void
+input_osc5522_error(struct input_ctx *ictx, const char *type, size_t tlen,
+    const char *id, const char *status)
+{
+	char	*body, *packet;
+
+	xasprintf(&body, "type=%.*s:status=%s", (int)tlen, type, status);
+	packet = input_osc5522_packet(body, strlen(body), id, ictx->input_end);
+	input_send_reply(ictx, packet);
+	free(packet);
+	free(body);
+}
+
+/* Handle the OSC 5522 sequence for the kitty clipboard protocol. */
+static void
+input_osc_5522(struct input_ctx *ictx, const char *p)
+{
+	struct window_pane	*wp = ictx->wp;
+	struct client		*c;
+	const char		*type, *id;
+	size_t			 len = strlen(p), tlen, idlen;
+	char			*paneid = NULL, *packet, tmuxid[32];
+
+	if (wp == NULL)
+		return;
+	if ((type = input_osc5522_get(p, len, "type", &tlen)) == NULL)
+		return;
+	if ((id = input_osc5522_get(p, len, "id", &idlen)) != NULL)
+		paneid = xstrndup(id, idlen);
+
+	if (input_osc5522_is(type, tlen, "read") ||
+	    input_osc5522_is(type, tlen, "write")) {
+		/* A new request takes the clipboard if it is free. */
+		c = input_find_client(wp, TERM_PASTEEVENTS);
+		if (c == NULL || input_osc5522_request.c != NULL) {
+			input_osc5522_error(ictx, type, tlen, paneid,
+			    c == NULL ? "ENOSYS" : "EBUSY");
+			free(paneid);
+			return;
+		}
+		input_osc5522_request.c = c;
+		input_osc5522_request.pane = wp->id;
+		input_osc5522_request.end = ictx->input_end;
+		input_osc5522_request.id = paneid;
+		input_osc5522_request.write = input_osc5522_is(type, tlen,
+		    "write");
+		input_osc5522_request.seq++;
+	} else if (input_osc5522_is(type, tlen, "wdata") ||
+	    input_osc5522_is(type, tlen, "walias")) {
+		/* Data continues the pane's own write. */
+		free(paneid);
+		c = input_osc5522_request.c;
+		if (c == NULL ||
+		    !input_osc5522_request.write ||
+		    input_osc5522_request.pane != wp->id)
+			return;
+	} else {
+		free(paneid);
+		return;
+	}
+
+	xsnprintf(tmuxid, sizeof tmuxid, "tmux-%u", input_osc5522_request.seq);
+	packet = input_osc5522_packet(p, len, tmuxid, INPUT_END_ST);
+	tty_puts(&c->tty, packet);
+	free(packet);
+	input_osc5522_start_timer();
+}
+
+/*
+ * Handle an OSC 5522 packet from a client terminal: a reply to the request in
+ * flight, or a paste event for the active pane.
+ */
+void
+input_osc5522_receive(struct client *c, const char *body, size_t len)
+{
+	struct window_pane	*wp;
+	const char		*id, *status;
+	size_t			 idlen, slen;
+	char			*packet, tmuxid[32];
+
+	log_debug("%s: %.*s", __func__, (int)len, body);
+
+	if ((id = input_osc5522_get(body, len, "id", &idlen)) == NULL) {
+		wp = c->session->curw->window->active;
+		if (~wp->screen->mode & MODE_PASTEEVENTS)
+			return;
+		packet = input_osc5522_packet(body, len, NULL, INPUT_END_ST);
+		input_send_reply(wp->ictx, packet);
+		free(packet);
+		return;
+	}
+
+	xsnprintf(tmuxid, sizeof tmuxid, "tmux-%u", input_osc5522_request.seq);
+	if (input_osc5522_request.c != c ||
+	    !input_osc5522_is(id, idlen, tmuxid))
+		return;
+
+	wp = window_pane_find_by_id(input_osc5522_request.pane);
+	if (wp != NULL) {
+		packet = input_osc5522_packet(body, len,
+		    input_osc5522_request.id, input_osc5522_request.end);
+		input_send_reply(wp->ictx, packet);
+		free(packet);
+	}
+
+	/* DONE or an error status (E...) ends the request. */
+	status = input_osc5522_get(body, len, "status", &slen);
+	if (input_osc5522_is(status, slen, "DONE") ||
+	    (status != NULL && slen != 0 && *status == 'E'))
+		input_osc5522_clear();
+	else
+		input_osc5522_start_timer();
+}
