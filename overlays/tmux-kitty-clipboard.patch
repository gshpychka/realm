+/* Next id for an OSC 5522 request. */
+static int	input_osc_5522_next;
+
+/* Find a metadata value in an OSC 5522 packet. */
+static const char *
+input_osc_5522_get(const char *buf, size_t len, const char *key, size_t *vlen)
+{
+	const char	*end, *entry, *next;
+	size_t		 keylen = strlen(key);
+
+	if ((end = memchr(buf, ';', len)) == NULL)
+		end = buf + len;
+	for (entry = buf; entry < end; entry = next + 1) {
+		if ((next = memchr(entry, ':', end - entry)) == NULL)
+			next = end;
+		if ((size_t)(next - entry) > keylen &&
+		    strncmp(entry, key, keylen) == 0 &&
+		    entry[keylen] == '=') {
+			*vlen = next - entry - keylen - 1;
+			return (entry + keylen + 1);
+		}
+	}
+	return (NULL);
+}
+
+/* Whether an OSC 5522 metadata value is the given string. */
+static int
+input_osc_5522_is(const char *value, size_t vlen, const char *s)
+{
+	return (value != NULL && vlen == strlen(s) &&
+	    strncmp(value, s, vlen) == 0);
+}
+
+/* Decode base64 from an OSC 5522 packet. */
+static char *
+input_osc_5522_decode(const char *value, size_t vlen, size_t *outlen)
+{
+	char	*copy;
+	u_char	*out;
+	size_t	 size = ((vlen + 3) / 4) * 3;
+	int	 n;
+
+	copy = xstrndup(value, vlen);
+	out = xmalloc(size + 1);
+	n = b64_pton(copy, out, size);
+	free(copy);
+	if (n == -1) {
+		free(out);
+		return (NULL);
+	}
+	out[n] = '\0';
+	*outlen = n;
+	return ((char *)out);
+}
+
+/* Whether a MIME type is plain text. */
+static int
+input_osc_5522_text_type(const char *type)
+{
+	return (strcmp(type, "text/plain") == 0 ||
+	    strncmp(type, "text/plain;", 11) == 0);
+}
+
+/* Build an OSC 5522 packet from a body with its id replaced. */
+static char *
+input_osc_5522_packet(const char *buf, size_t len, const char *id,
+    enum input_end_type end)
+{
+	const char	*meta_end, *entry, *next;
+	char		*meta, *tmp, *packet;
+
+	if ((meta_end = memchr(buf, ';', len)) == NULL)
+		meta_end = buf + len;
+	meta = xstrdup("");
+	for (entry = buf; entry < meta_end; entry = next + 1) {
+		if ((next = memchr(entry, ':', meta_end - entry)) == NULL)
+			next = meta_end;
+		if (next - entry >= 3 && strncmp(entry, "id=", 3) == 0)
+			continue;
+		xasprintf(&tmp, "%s%s%.*s", meta, *meta == '\0' ? "" : ":",
+		    (int)(next - entry), entry);
+		free(meta);
+		meta = tmp;
+	}
+	if (id != NULL) {
+		xasprintf(&tmp, "%s%sid=%s", meta, *meta == '\0' ? "" : ":",
+		    id);
+		free(meta);
+		meta = tmp;
+	}
+	xasprintf(&packet, "\033]5522;%s%.*s%s", meta,
+	    (int)(buf + len - meta_end), meta_end,
+	    end == INPUT_END_BEL ? "\007" : "\033\\");
+	free(meta);
+	return (packet);
+}
+
+/* Send an OSC 5522 packet to a pane under the pane's own id. */
+static void
+input_osc_5522_send(struct input_ctx *ictx, const char *buf, size_t len,
+    const char *id, enum input_end_type end)
+{
+	char	*packet;
+
+	packet = input_osc_5522_packet(buf, len, id, end);
+	input_send_reply(ictx, packet);
+	free(packet);
+}
+
+/* Reply to a pane's OSC 5522 request with a status. */
+static void
+input_osc_5522_status(struct input_ctx *ictx, const char *type,
+    const char *id, const char *status, enum input_end_type end)
+{
+	char	*buf;
+
+	xasprintf(&buf, "type=%s:status=%s", type, status);
+	input_osc_5522_send(ictx, buf, strlen(buf), id, end);
+	free(buf);
+}
+
+/* Send data to a pane as OSC 5522 read data, in chunks of 4096 bytes. */
+static void
+input_osc_5522_data(struct input_ctx *ictx, const char *id, const char *mime,
+    const char *data, size_t len)
+{
+	char	 chunk[((4096 + 2) / 3) * 4 + 1], *b64mime, *buf;
+	size_t	 i, n, mlen = strlen(mime), size = ((mlen + 2) / 3) * 4 + 1;
+
+	b64mime = xmalloc(size);
+	b64_ntop(mime, mlen, b64mime, size);
+	for (i = 0; i < len; i += n) {
+		n = (len - i > 4096) ? 4096 : len - i;
+		b64_ntop(data + i, n, chunk, sizeof chunk);
+		xasprintf(&buf, "type=read:status=DATA:mime=%s;%s", b64mime,
+		    chunk);
+		input_osc_5522_send(ictx, buf, strlen(buf), id,
+		    ictx->input_end);
+		free(buf);
+	}
+	free(b64mime);
+}
+
+/* Answer an OSC 5522 read with the newest paste buffer, as text/plain. */
+static void
+input_osc_5522_buffer_reply(struct input_ctx *ictx, const char *buf,
+    size_t len, const char *id)
+{
+	struct paste_buffer	*pb;
+	const char		*payload, *data;
+	char			*types, *next, *type;
+	size_t			 tlen, dlen;
+
+	input_osc_5522_status(ictx, "read", id, "OK", ictx->input_end);
+	pb = paste_get_top(NULL);
+	payload = memchr(buf, ';', len);
+	if (pb != NULL && payload != NULL) {
+		payload++;
+		types = input_osc_5522_decode(payload, buf + len - payload,
+		    &tlen);
+		next = types;
+		while (next != NULL && (type = strsep(&next, " \t\r\n"))) {
+			if (strcmp(type, ".") == 0) {
+				input_osc_5522_data(ictx, id, ".",
+				    "text/plain", 10);
+				break;
+			}
+			if (input_osc_5522_text_type(type)) {
+				data = paste_buffer_data(pb, &dlen);
+				input_osc_5522_data(ictx, id, type, data, dlen);
+				break;
+			}
+		}
+		free(types);
+	}
+	input_osc_5522_status(ictx, "read", id, "DONE", ictx->input_end);
+}
+
+/* Add the text/plain data in an OSC 5522 packet to a request's buffer. */
+static void
+input_osc_5522_collect(struct input_osc_5522_state *os, const char *buf,
+    size_t len)
+{
+	const char	*mime, *data;
+	char		*decoded = NULL, *type;
+	size_t		 mlen, dlen, tlen;
+
+	if (!os->buffer)
+		return;
+	if ((mime = input_osc_5522_get(buf, len, "mime", &mlen)) == NULL)
+		return;
+	if ((type = input_osc_5522_decode(mime, mlen, &tlen)) == NULL)
+		return;
+	if (!input_osc_5522_text_type(type)) {
+		free(type);
+		return;
+	}
+	free(type);
+	if ((data = memchr(buf, ';', len)) == NULL)
+		return;
+	data++;
+	dlen = buf + len - data;
+
+	/* A read sends padded chunks; a write pads only the whole. */
+	if (!os->write) {
+		decoded = input_osc_5522_decode(data, dlen, &dlen);
+		data = decoded;
+	}
+	if (data == NULL || os->textlen + dlen > input_buffer_size) {
+		free(os->text);
+		os->text = NULL;
+		os->textlen = 0;
+		os->buffer = 0;
+	} else {
+		os->text = xrealloc(os->text, os->textlen + dlen + 1);
+		memcpy(os->text + os->textlen, data, dlen);
+		os->textlen += dlen;
+		os->text[os->textlen] = '\0';
+	}
+	free(decoded);
+}
+
+/* Create a paste buffer from a request's text/plain data. */
+static void
+input_osc_5522_paste(struct input_osc_5522_state *os)
+{
+	char	*data;
+	size_t	 len;
+
+	if (!os->buffer || os->text == NULL)
+		return;
+	if (os->write) {
+		data = input_osc_5522_decode(os->text, os->textlen, &len);
+		free(os->text);
+	} else {
+		data = os->text;
+		len = os->textlen;
+	}
+	os->text = NULL;
+	os->textlen = 0;
+	if (data != NULL && len != 0)
+		paste_add(NULL, data, len);
+	else
+		free(data);
+}
+
+/* Free OSC 5522 request state. */
+static void
+input_osc_5522_free(struct input_osc_5522_state *os)
+{
+	free(os->id);
+	free(os->text);
+}
+
+/* Find a pane's OSC 5522 request. */
+static struct input_request *
+input_osc_5522_find(struct input_ctx *ictx)
+{
+	struct input_request	*ir;
+
+	TAILQ_FOREACH(ir, &ictx->requests, entry) {
+		if (ir->type == INPUT_REQUEST_OSC5522)
+			return (ir);
+	}
+	return (NULL);
+}
+
+/* Whether a client has an OSC 5522 request in flight. */
+static int
+input_osc_5522_busy(struct client *c)
+{
+	struct input_request	*ir;
+
+	TAILQ_FOREACH(ir, &c->input_requests, centry) {
+		if (ir->type == INPUT_REQUEST_OSC5522)
+			return (1);
+	}
+	return (0);
+}
+
+/* Send a pane's OSC 5522 packet to the request's client under tmux's id. */
+static void
+input_osc_5522_forward(struct input_request *ir, const char *buf, size_t len)
+{
+	char	 id[32], *packet;
+
+	ir->t = get_timer();
+	if (ir->c == NULL)
+		return;
+	xsnprintf(id, sizeof id, "tmux-%d", ir->idx);
+	packet = input_osc_5522_packet(buf, len, id, INPUT_END_ST);
+	tty_puts(&ir->c->tty, packet);
+	free(packet);
+}
+
+/* Handle OSC 5522 write data, which continues the pane's write request. */
+static void
+input_osc_5522_wdata(struct input_ctx *ictx, const char *p, size_t len)
+{
+	struct input_request		*ir;
+	struct input_osc_5522_state	*os;
+	const char			*type;
+	size_t				 tlen, mlen;
+
+	if ((ir = input_osc_5522_find(ictx)) == NULL)
+		return;
+	os = ir->data;
+	if (!os->write)
+		return;
+	input_osc_5522_collect(os, p, len);
+	input_osc_5522_forward(ir, p, len);
+
+	/* The last packet is wdata with no MIME type. */
+	type = input_osc_5522_get(p, len, "type", &tlen);
+	if (!input_osc_5522_is(type, tlen, "wdata") ||
+	    input_osc_5522_get(p, len, "mime", &mlen) != NULL)
+		return;
+	input_osc_5522_paste(os);
+	if (ir->c == NULL) {
+		input_osc_5522_status(ictx, "write", os->id, "DONE", ir->end);
+		input_free_request(ir);
+	}
+}
+
+/* Handle the OSC 5522 sequence for the kitty clipboard protocol. */
+static void
+input_osc_5522(struct input_ctx *ictx, const char *p)
+{
+	struct window_pane		*wp = ictx->wp;
+	struct input_request		*ir;
+	struct input_osc_5522_state	*os;
+	struct client			*c;
+	const char			*type, *v, *what;
+	size_t				 len = strlen(p), tlen, vlen;
+	char				*id = NULL;
+	int				 write, state, buffer = 0;
+
+	/* Replies go to a pane, so popups are ignored. */
+	if (wp == NULL)
+		return;
+	if ((type = input_osc_5522_get(p, len, "type", &tlen)) == NULL)
+		return;
+	if (input_osc_5522_is(type, tlen, "wdata") ||
+	    input_osc_5522_is(type, tlen, "walias")) {
+		input_osc_5522_wdata(ictx, p, len);
+		return;
+	}
+	write = input_osc_5522_is(type, tlen, "write");
+	if (!write && !input_osc_5522_is(type, tlen, "read"))
+		return;
+	what = write ? "write" : "read";
+	if ((v = input_osc_5522_get(p, len, "id", &vlen)) != NULL)
+		id = xstrndup(v, vlen);
+
+	/* A new request replaces the pane's unfinished one. */
+	if ((ir = input_osc_5522_find(ictx)) != NULL)
+		input_free_request(ir);
+
+	if (write) {
+		if (options_get_number(global_options, "set-clipboard") != 2) {
+			input_osc_5522_status(ictx, what, id, "EPERM",
+			    ictx->input_end);
+			goto out;
+		}
+		buffer = 1;
+	} else {
+		/*
+		 * A read with the password of the last paste event follows
+		 * the user's paste, so goes to the terminal whatever
+		 * get-clipboard says.
+		 */
+		state = options_get_number(global_options, "get-clipboard");
+		v = input_osc_5522_get(p, len, "pw", &vlen);
+		if (ictx->paste_pw != NULL &&
+		    input_osc_5522_is(v, vlen, ictx->paste_pw)) {
+			free(ictx->paste_pw);
+			ictx->paste_pw = NULL;
+		} else if (state == 0) {
+			input_osc_5522_status(ictx, what, id, "EPERM",
+			    ictx->input_end);
+			goto out;
+		} else if (state == 1) {
+			input_osc_5522_buffer_reply(ictx, p, len, id);
+			goto out;
+		}
+		buffer = (state == 3);
+	}
+
+	/* Without a terminal to relay to, tmux takes a write by itself. */
+	c = input_find_client(wp);
+	if (c != NULL && !tty_term_has(c->tty.term, TTYC_ENPE))
+		c = NULL;
+	if (c == NULL && !write) {
+		input_osc_5522_status(ictx, what, id, "ENOSYS",
+		    ictx->input_end);
+		goto out;
+	}
+	if (c != NULL && input_osc_5522_busy(c)) {
+		input_osc_5522_status(ictx, what, id, "EBUSY", ictx->input_end);
+		goto out;
+	}
+
+	os = xcalloc(1, sizeof *os);
+	os->id = id;
+	os->write = write;
+	os->buffer = buffer;
+
+	ir = input_make_request(ictx, INPUT_REQUEST_OSC5522);
+	ir->idx = input_osc_5522_next;
+	input_osc_5522_next = (input_osc_5522_next + 1) % INT_MAX;
+	ir->end = ictx->input_end;
+	ir->data = os;
+	if (c != NULL) {
+		ir->c = c;
+		TAILQ_INSERT_TAIL(&c->input_requests, ir, centry);
+	}
+	input_osc_5522_forward(ir, p, len);
+	return;
+
+out:
+	free(id);
+}
+
+/*
+ * Handle an OSC 5522 packet from a client: a reply to a request, or a paste
+ * event for the active pane.
+ */
+void
+input_osc_5522_receive(struct client *c, const char *buf, size_t len)
+{
+	struct input_request_osc5522_data	 od;
+	struct window_pane			*wp;
